# Applied on a fresh `idf.py` reconfigure/fullclean when no local `sdkconfig`
# exists yet (sdkconfig itself is gitignored -- generated, machine-local).
#
# CONFIG_COMPILER_OPTIMIZATION_SIZE (-Os, not the ESP-IDF default -Og debug
# build): the `factory` app partition is fixed at 1500K (partitions.csv --
# resizing it means touching the offsets of every partition after it, which
# holds live NVS data on a real board, so it stays fixed rather than growing
# to fit the binary). Under -Og, KilnCtrl.bin already fills that partition to
# ~1% free before TODO.md 10.9 (LCD network page + QR codes); with 10.9's code
# added it overflows outright. -Os alone reclaims ~125K, landing at ~9% free
# with 10.9 included -- see TODO.md 10.9's "Build-config note" for the full
# story. Without this file, a fresh checkout silently regresses to -Og and
# fails to build once 10.9's code is present.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# CONFIG_LV_USE_BUILTIN_MALLOC (LVGL's default) reserves a static 64K pool
# (CONFIG_LV_MEM_SIZE_KILOBYTES) carved permanently out of internal DRAM,
# unrelated to the PSRAM configured for LVGL's draw buffers earlier this
# project (that only covers frame-buffer memory, not LVGL's own object
# allocator). Found the hard way 2026-08-18: after TODO.md 10.9 added
# ui_page_network.c, real hardware showed "Failed to start io/lvgl_port/
# safety/control/profiles/autotune/wifi uart bridge task" at boot --
# internal DRAM was chronically exhausted (only ~104K free of 341K), not
# a transient WiFi-bringup spike (see App/drivers/espInterfaces/
# uart_protocol.c's registration-retry comment for that adjacent, real but
# insufficient-by-itself fix). Switching to CONFIG_LV_USE_CLIB_MALLOC lets
# LVGL's allocations go through the system malloc(), which is PSRAM-aware
# (CONFIG_SPIRAM_USE_MALLOC=y) -- reclaimed the full ~64-68K, landing at
# ~172K free. Every UART bridge task and the LVGL display task itself
# start successfully with this set; without it, the LCD does not
# initialize at all on this build.
#
# Do NOT switch this to CONFIG_LV_USE_BUILTIN_MALLOC. Tried 2026-08-20 and
# reverted: LVGL's many small object allocations were (correctly) identified
# as the thing fragmenting the internal DRAM heap -- the largest contiguous
# DRAM block is a healthy 163840 bytes at 1.4s into boot and has collapsed to
# ~2560 bytes by 2.9s, which is when the UI is built -- and the built-in
# allocator looked like the fix, since it confines LVGL to one arena instead
# of scattering allocations through the shared heap. On hardware, enabling it
# (64KB pool, LV_MEM_ADR=0) made the board stop responding entirely: no boot
# log, no PC link, dead. Reverting restored it. The pool is a static array,
# so with LV_MEM_ADR=0 it lands in .bss/DRAM on top of everything else rather
# than relieving anything.
#
# The idea is still sound -- LVGL is the fragmenter -- but making it work
# needs the pool placed in PSRAM (EXT_RAM_BSS_ATTR / a custom
# LV_MEM_POOL_ALLOC), not merely switched to the built-in allocator. Until
# someone does that carefully, CLIB malloc plus the explicit
# xTaskCreatePinnedToCoreWithCaps()/xQueueCreateWithCaps() moves in
# lvgl_port.c, uart_bridge.c and uart_protocol.c is what keeps this board
# booting.
CONFIG_LV_USE_CLIB_MALLOC=y

# CONFIG_LV_USE_QRCODE: off by default in upstream LVGL. ui_page_network.c
# and ui_page_home.c (TODO.md 10.9) call lv_qrcode_create()/_update() for the
# AP-join/dashboard/IP QR codes -- without this, those calls don't exist and
# the build fails. It was flipped on in the local, gitignored `sdkconfig`
# during 10.9's original pass but never carried forward into this file, so a
# fresh checkout silently lost it (found while auditing 10.9 for this pass --
# see TODO.md 10.9's checklist status note).
CONFIG_LV_USE_QRCODE=y

# CONFIG_ESP_MAIN_TASK_STACK_SIZE: found the hard way 2026-08-19, on real
# hardware. Board booted, printed ILI9488's "kilnCtl ready" boot banner to
# the panel (App/drivers/ILI9488.c), then hung there forever -- looked from
# the outside like a frozen splash screen, and was invisible over this
# app's own PC link (the reliable-UART log bridge never gets to start; see
# uart_log_bridge.c) because the bench's separate PC<->ESP USB-serial UART
# (COM9) was independently dead this same session. Read live boot output
# instead over the ESP32-S3's native USB-Serial-JTAG port (a second, always-
# present serial device distinct from COM9 -- CONFIG_ESP_CONSOLE_SECONDARY_
# USB_SERIAL_JTAG is already on, so ESP-IDF's own console mirrors there
# regardless of whether this app's own link is up), which showed the real
# fault: "***ERROR*** A stack overflow in task main has been detected",
# repeating every ~1s in an unbroken reboot loop, always after the ILI9488
# banner and always around PC-link (uart_owner_init) bring-up. `main_task`
# (the FreeRTOS task app_main() runs on) never got a config here before --
# ESP-IDF's plain default, 3584 bytes, sized for a typical minimal app_main,
# not one that chains I2C + SPI + Wi-Fi/mDNS + several HTTP server
# registrations + SX1509 + three MAX31856 channels + ILI9488 + NS2009 touch
# + LVGL setup + a dozen UART bridge task starts, all inline, all before
# returning. Raised generously (8192, 2.3x the old value) rather than to
# the bare minimum that happens to survive this one boot path -- a tight
# margin here is exactly the kind of thing that comes back the next time
# this function grows. Not yet reprofiled to find the true peak usage; a
# future pass could measure it precisely (uxTaskGetStackHighWaterMark) and
# right-size this rather than carry a guessed margin indefinitely.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# CONFIG_LWIP_MAX_SOCKETS: found the hard way 2026-08-20 auditing this file
# after wifi_provision_http.c's `config.max_open_sockets = 13` fix (see that
# file's comment at the same line, added the same pass) -- this project's
# `sdkconfig` had CONFIG_LWIP_MAX_SOCKETS raised 10 -> 16 to satisfy it, but
# that edit was made through menuconfig, which only ever writes the
# gitignored, machine-local `sdkconfig`, never this file. A fresh checkout
# regenerates `sdkconfig` from this file plus ESP-IDF's own defaults, which
# means CONFIG_LWIP_MAX_SOCKETS would silently fall back to 10 -- verified by
# deleting `sdkconfig` and running `idf.py reconfigure` with this fix absent.
# ESP-IDF enforces max_open_sockets <= CONFIG_LWIP_MAX_SOCKETS - 3 inside
# httpd_start() (see wifi_provision_http.c); with the default of 10 that caps
# max_open_sockets at 7, so httpd_start() for the dashboard/captive-portal
# server returns ESP_ERR_INVALID_ARG and the board boots with NO web server
# at all -- no dashboard, no AP-join page, nothing reachable over WiFi. This
# is a hard dependency, not a tuning knob: do NOT lower this back toward 10
# without also lowering wifi_provision_http.c's max_open_sockets to match
# (and re-checking it still survives the ~10-connection dashboard-polling
# burst documented there), or the server will fail to start on next boot.
CONFIG_LWIP_MAX_SOCKETS=16

# CONFIG_SPIRAM and friends: found the hard way 2026-08-20, same audit pass
# as CONFIG_LWIP_MAX_SOCKETS above and for the identical reason -- this
# board's octal PSRAM is enabled only in the gitignored, machine-local
# `sdkconfig` (set once through menuconfig years ago) and was never carried
# into this file. Verified by deleting `sdkconfig` and running
# `idf.py reconfigure`: with this block absent, the regenerated sdkconfig
# comes back "# CONFIG_SPIRAM is not set" -- PSRAM off entirely. That is not
# a minor regression on this board: CONFIG_LV_USE_CLIB_MALLOC above depends
# on CONFIG_SPIRAM_USE_MALLOC=y to route LVGL's allocator to PSRAM (without
# it the LCD does not initialize -- see that entry's comment), and
# App/drivers/uart_bridge_ext.c's xTaskCreatePinnedToCoreWithCaps(...,
# MALLOC_CAP_SPIRAM) calls for the UART bridge tasks have nowhere to
# allocate from without PSRAM present, so those tasks would fail to start
# too. CLK_IO/CS_IO/mode/speed below are this board's actual wiring (copied
# from the working `sdkconfig`), not guesses -- do not change them without
# confirming against the schematic.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_CLK_IO=30
CONFIG_SPIRAM_CS_IO=26
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
#
# Internal-SRAM pressure, measured 2026-08-20. The board booted reporting
# ~243KB of internal heap free but a largest contiguous internal block of
# only 992 bytes (uart_bridge_ext.c logs both at each bridge-task creation).
# Any allocation bigger than that fails regardless of the free total, which
# is exactly what UART task 12 (gpio_probe) hit: its uart_protocol inbox
# xQueueCreate() failed every boot with "internal SRAM genuinely exhausted",
# leaving the task running with no inbox and NACKing every request.
#
# Two knobs drive that, and both were working against this board:
#
#   ALWAYSINTERNAL is the size BELOW which an allocation is forced into
#   internal RAM. At 16384 essentially every routine allocation in the
#   firmware -- queues, small buffers, driver state -- was pinned to internal
#   RAM and none of it could ever spill to the 8MB of PSRAM sitting idle.
#   4096 keeps genuinely small/hot allocations internal (where PSRAM's
#   latency would hurt) while letting anything mid-sized use PSRAM.
#
#   TRY_ALLOCATE_WIFI_LWIP lets the Wi-Fi and lwIP stacks take their buffer
#   pools from PSRAM. Those pools are among the largest internal consumers on
#   this board, and this project made them bigger on the same day: the httpd
#   concurrency fix raised max_open_sockets to 13 and CONFIG_LWIP_MAX_SOCKETS
#   to 16 (see the LWIP_MAX_SOCKETS comment above), so leaving this off meant
#   paying for that fix entirely out of the scarcest pool.
#
# DMA-capable allocations are unaffected either way -- those request
# MALLOC_CAP_DMA explicitly and always come from internal RAM, and
# MALLOC_RESERVE_INTERNAL below keeps a floor for them.
# Both values below are DELIBERATELY unchanged from the IDF defaults. Tried
# and reverted, 2026-08-20 -- recorded here so the next person does not repeat
# it:
#
#   ALWAYSINTERNAL 16384 -> 4096, and TRY_ALLOCATE_WIFI_LWIP off -> on, on the
#   reasoning that pushing mid-sized allocations and the Wi-Fi/lwIP buffer
#   pools into PSRAM would relieve the internal shortage. On real hardware it
#   made things WORSE, not better: the LVGL display task stopped starting at
#   all ("Failed to start lvgl_port_task"), more UART task inboxes failed than
#   before, and the PC-link safety watchdog failed to start with ESP_ERR_NO_MEM.
#   Reverting both restored the previous behaviour.
#
# The lesson is that the shortage here is FRAGMENTATION, not total free bytes:
# the board reports ~243KB internal free while the largest contiguous block is
# ~1-2.5KB. Global allocator knobs shift which pool small allocations come
# from; they do nothing for a multi-KB contiguous request, and can worsen
# fragmentation. What actually fixed it was moving specific large, long-lived
# allocations to PSRAM explicitly at their call sites -- task stacks via
# xTaskCreatePinnedToCoreWithCaps() and the UART inbox queues via
# xQueueCreateWithCaps(). See lvgl_port.c, uart_bridge.c, uart_bridge_ext.c
# and espInterfaces/uart_protocol.c.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# CONFIG_PARTITION_TABLE_CUSTOM: found the hard way 2026-08-20, same audit
# pass, same root cause as the two entries above (a menuconfig-only change
# that never made it into this file) -- and this one reproduces immediately.
# Deleting `sdkconfig` and running `idf.py reconfigure` + a full ninja build
# with this line absent fails at the partition-size-check step:
#   Error: app partition is too small for binary KilnCtrl.bin size 0x15f490:
#   - Part 'factory' 0/0 @ 0x10000 size 0x100000 (overflow 0x5f490)
# Without CONFIG_PARTITION_TABLE_CUSTOM=y, ESP-IDF falls back to
# CONFIG_PARTITION_TABLE_SINGLE_APP (partitions_singleapp.csv, a fixed 1MB
# factory partition) instead of this project's partitions.csv (factory
# fixed at 1500K -- see CONFIG_COMPILER_OPTIMIZATION_SIZE's comment above
# for why that size is fixed rather than grown). The 1MB default is smaller
# than KilnCtrl.bin even with -Os, so a fresh checkout fails to link a
# flashable image at all, not just at boot. Without CUSTOM_FILENAME here,
# CONFIG_PARTITION_TABLE_FILENAME does not get set to partitions.csv either.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# CONFIG_ESPTOOLPY_FLASHSIZE: found the hard way 2026-08-20, same audit pass,
# same root cause again -- reproduces immediately and is even more fatal than
# the two entries above. Deleting `sdkconfig` and reconfiguring+building with
# this absent fails during partition-table generation itself, before any app
# code is even linked:
#   Partitions tables occupies 6.9MB of flash (7274496 bytes) which does not
#   fit in configured flash size 2MB.
# ESP-IDF's default flash size is 2MB; partitions.csv (see its own header
# comment, "CONFIG_ESPTOOLPY_FLASHSIZE was corrected from 2MB to 16MB earlier
# this session") lays out the OTA dual-app-slot table across the first
# ~7.28 MB of this board's real 16 MB (N16R8 module) flash chip. Without this
# pinned to 16MB, a fresh checkout cannot even generate a partition table,
# let alone build or flash.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# CONFIG_ESP_COREDUMP_*: spontaneous-reboot diagnosability pass, 2026-08-20
# (see firmware/KilnFW/TODO.md and partitions.csv's "coredump partition,
# added 2026-08-20" comment). The board was seen rebooting on the bench with
# no panic text recoverable -- the panic handler writes straight to the
# USB-Serial-JTAG console, which re-enumerates across the reset and drops
# whatever was captured on the PC side in that window. Writing the panic
# reason, backtrace, and task states to the new `coredump` flash partition
# instead means they survive the reset and can be read back afterward with
# espcoredump.py, no serial capture window to lose.
#
# Following this file's own established pattern (CONFIG_LWIP_MAX_SOCKETS /
# CONFIG_SPIRAM / CONFIG_PARTITION_TABLE_CUSTOM above): put it here, not only
# in the gitignored local `sdkconfig`, or a fresh checkout silently loses
# crash diagnosability entirely -- exactly the class of bug this file's
# preceding three entries were all found fixing.
#
# ESP_COREDUMP_DATA_FORMAT_ELF / _CHECKSUM_SHA256 are deliberately NOT set
# here: checked against components/espcoredump/Kconfig in this repo's pinned
# IDF v6.0.2 (C:\esp\v6.0.2\esp-idf) -- `ESP_COREDUMP_ENABLE` (itself
# selected by ENABLE_TO_FLASH below) unconditionally `select`s both, and
# neither has a Kconfig `bool`/prompt of its own in this IDF version (the
# legacy binary-format and CRC32-checksum choices from older IDF releases
# no longer exist as user-facing options). Setting them here produced a
# `NOTE: unknown kconfig symbol` build warning -- harmless, but noise this
# file should not carry. ELF is what espcoredump.py's
# `info_corefile`/`dbg_corefile` expect; SHA256 is this IDF version's only
# integrity check for a partially-written/torn dump (e.g. a second panic
# before the flash write completes) -- both are on by construction via the
# select chain, not by anything in this file.
# CONFIG_ESP_COREDUMP_MAX_TASKS_NUM: this app starts on the order of a few
# dozen FreeRTOS tasks (I2C/SPI drivers, HTTP handlers, every UART bridge
# task in App/main.c, LVGL, safety link, etc.). 64 is this Kconfig's own
# default in v6.0.2 already -- pinned explicitly here so a dump taken with
# everything running still captures every task's state rather than silently
# truncating the list, regardless of what a future IDF version's default
# becomes.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=64
