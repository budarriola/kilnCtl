# KilnFW_recovery sdkconfig defaults. Deliberately minimal: this image's
# entire value is having almost nothing that can fail (docs/
# OTA_SINGLE_SLOT_PLAN.md section 3), so it takes on none of the main
# KilnFW project's PSRAM/LVGL/UART-bridge configuration.

CONFIG_IDF_TARGET="esp32s3"

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Stock rollback support -- section 4 of the plan relies on the bootloader's
# own PENDING_VERIFY/ABORTED handling; the recovery image itself does not
# self-confirm (it never runs a control loop to judge), but keeping this on
# costs nothing and keeps behaviour uniform with the main app image.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# No PSRAM on this image -- the display line, Wi-Fi and httpd all fit
# comfortably in internal DRAM at this image's scale, and leaving PSRAM out
# removes an entire bring-up dependency from the one image that must not
# fail (see main KilnFW's own sdkconfig.defaults comments on how much
# complexity SPIRAM bring-up costs there).
# CONFIG_SPIRAM is not set

# Single, small nonce/HMAC-scale HTTP server -- no need for esp-tls's larger
# receive buffers or many concurrent sockets.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
