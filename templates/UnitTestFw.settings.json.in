{
  "C_Cpp.intelliSenseEngine": "default",
  "idf.extensionActivationMode": "always",
  "idf.openOcdConfigs": [
    "board/esp32s3-builtin.cfg"
  ],
  "idf.currentSetup": "@@IDF_PATH@@",
  "idf.customExtraVars": {
    "IDF_TARGET": "esp32s3"
  },
  "clangd.path": "@@CLANGD@@",
  "clangd.arguments": [
    "--background-index",
    "--query-driver=**",
    "--compile-commands-dir=${workspaceFolder}/build"
  ],
  "idf.flashType": "JTAG",
  "actionButtons": {
    "defaultColor": "#ffffff",
    "commands": [
      {
        "name": "$(plug) PcTools GUI",
        "color": "#42b883",
        "singleInstance": true,
        "useVsCodeApi": true,
        "command": "workbench.action.tasks.runTask",
        "args": "PcTools: Open GUI"
      }
    ]
  }
}
