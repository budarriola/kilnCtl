# Secrets - never commit. See .env.example for the expected keys.
/.env

# kilnctrl MCP/GUI Wi-Fi credential cache (tools/PcTools) - local-only, lets the
# MCP auto-rejoin the board's home network without prompting each session.
/tools/PcTools/wifi_credentials.json

# Mouser lookup result cache (tools/mykicadMcp/kicad_mouser_tool.py) - local speed-up only.
/.mouser_cache.json

# --- KiCad working files ---------------------------------------------------
# These patterns are deliberately unanchored. The previous anchored forms
# (/mainBoard/..., /ThermocoupleBoard/...) stopped matching the moment the tree
# was reorganised into hardware/ and firmware/, which silently exposed a pile of
# backup archives and autorouter scratch files. Unanchored patterns survive a
# board moving between directories.
*-backups/
#auto_saved_files#
_autosave*.kicad_sch
*.kicad_pro.lck
*.lck
/hardware/mainBoard/kiln.csv

# Autorouter per-board working state (mykicadMcp NETCLASS_PLAN Phase 7) -
# disposable and machine-local; policy lives in the committed pcb_settings.json.
*.board_local.json
*.route_progress.jsonl

# Root-level KiCad export scratch. Per-board output/ directories are tracked -
# they hold the schematic PDFs.
/output/

# --- Tooling ---------------------------------------------------------------
# tools/mykicadMcp/ is a separate git submodule (github.com/budarriola/mykicadMcp);
# its own .gitignore covers the venv, caches, editor settings, and runtime log.

# pdf-mcp (github.com/jztan/pdf-mcp) - third-party MCP server, installed local-only.
/tools/pdfMcp/
/pdfMcp/

# --- Python ----------------------------------------------------------------
__pycache__/
.venv/
.pytest_cache/

# --- Editor ----------------------------------------------------------------
/.vscode/

# --- Windows ---------------------------------------------------------------
# A shell with no /dev/null turns a redirect into a file literally named "nul",
# which is then awkward to delete. Ignore it so it never gets committed again.
nul

# --- Machine-specific, generated by tools/setup.ps1 from templates/ ----------
# These hold absolute toolchain paths (ESP-IDF, clangd, OpenOCD) and serial
# ports, which differ on every machine. Edit the template, not the output, or
# the next setup run will overwrite your change. See docs/SETUP.md.
/.mcp.json
/firmware/KilnFW/.vscode/settings.json
/firmware/KilnFW/.vscode/c_cpp_properties.json
/firmware/KilnFW/.vscode/tasks.json

# Claude Code creates a git worktree per subagent that runs with worktree
# isolation. They are scratch checkouts, not project content -- four of them were
# swept into a commit by a `git add -A` and became gitlinks with no .gitmodules
# entry, which broke `git submodule status`. Never commit them.
/.claude/worktrees/

# Research papers read while planning the PID work (docs/research/). The PDFs
# are third-party published papers -- redistributing them from this repo is a
# licensing question nobody here has answered, and they are large binaries that
# would bloat every clone. Only the *citations* are tracked: CREDITS.md names
# the five that informed a recommendation, and
# firmware/KilnFW/docs/PID_EXPANSION_PLAN.md cites all ten by title and
# filename. Anyone can re-fetch a paper from its citation; nobody needs the
# blob in their history.
/docs/research/

# Vendor LCD module datasheets/demo code -- reference only, not built
firmware/KilnFW/Datasheets/4.0inch_SPI_Module_ST7796_MSP4030_MSP4031_V1.0/

# pid_validation_harness.py --dry-run artifact (its stage_backup_roundtrip
# writes here by default even with no board) -- a test-run byproduct, not a
# tracked config preset.
/tools/PcTools/config_presets/pid_validation_backup.json

# Host-test scratch dirs: log_store tests create these relative to CWD,
# so they appear wherever the suite was run from.
log_store_test_*/

# Host-test scratch build dir
build_agent/

# Raw bench captures from the tuning/coupling campaigns (85 MB and growing).
# The convention this repo already follows: the ANALYSIS lives in git --
# logs/coupling/*.md and the pid_ab_compare *.txt reports are all tracked --
# while the multi-megabyte per-tick JSONL the analysis was computed from is
# not. A capture is also frequently still being appended to while a run is in
# flight, so committing one races the writer.
logs/**/*.jsonl
logs/**/*.jsonl.aborted
logs/**/*_state.json
logs/**/*_campaign_state.json
logs/**/*_run_queue.log
logs/**/*.aborted

# idf.py menuconfig writes these next to the (already-ignored) sdkconfig.
firmware/KilnFW/sdkconfig.bak_*

# Host-test scratch dirs from kiln_cfg_store.c / cfg filesystem tests --
# created relative to CWD (repo root, or firmware/KilnFW/App/test/) whenever
# the suite runs, same pattern as log_store_test_*/ above.
cfg_fs_test_*/
cfg_fs_status_test_*/

# Host-test scratch build dirs for the sim/iter-tune/scenario harnesses --
# named ad hoc by whichever check invoked them (e.g.
# build_sim_iter_tune_bars_obj/, build_sim_scenarios_check_obj/), same class
# of byproduct as build_agent/ above.
build_sim_*_obj/

# Loose Windows-COFF .obj files land at repo root when a host-test build or a
# quick sizeof()/probe compile is invoked with cwd left at the repo root
# instead of a build directory (sizeof_before.obj, probe3.obj, and similar
# one-off compiler scratch). Not build output anyone commits on purpose.
/*.obj
